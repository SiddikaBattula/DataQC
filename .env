DB_USERNAME=root
DB_PASSWORD=ofiil
DB_PORT=8100


TZ=Asia/Kolkata



# --- API bind address --------------------------------------------------------
# Leave HOST as 0.0.0.0 inside Docker, otherwise the port mapping cannot reach it.
HOST=0.0.0.0
PORT=8000

# --- Logging -----------------------------------------------------------------
# Logs go to the terminal only; no log file is written.
# DEBUG shows the SQL query and the percentage-change values.
# INFO (default) shows requests, row counts and alerts.
LOG_LEVEL=INFO

# auto = colour only when attached to a terminal | always | never
LOG_COLOR=auto

